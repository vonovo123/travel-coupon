# 코드세이아 로컬/배포 환경 변수 예시
# 복사: cp .env.example .env.local

# 사이트 절대 URL (canonical, OG, sitemap). 배포는 https://www.codysseia.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 네이버 블로그 RSS ID (https://rss.blog.naver.com/{ID}.xml)
# NAVER_BLOG_ID=dlthdus12345

# Sanity — Next 사이트용
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-09

# Sanity Studio (`npm run sanity:dev`)용. Vite는 SANITY_STUDIO_ 접두사만 브라우저에 넣음.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-09-09

# 초안(draft) 읽기·웹훅용. Studio 로그인과는 별개.
# SANITY_API_READ_TOKEN=
# sanity deploy 호스트명 (https://<host>.sanity.studio)
SANITY_STUDIO_HOST=codeyssey
